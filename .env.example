# Public site origin. Use HTTPS and NODE_ENV=production when deployed.
APP_URL=http://localhost:3100
FRONTEND_PORT=3100
API_PORT=
# Interface for the public listener. Default is loopback only; set HOST=0.0.0.0 behind a TLS-terminating
# reverse proxy to accept remote connections (the internal API listener always stays on loopback).
HOST=
NODE_ENV=development
# Personal email/password authentication is the default.
# Demo identities are always disabled in production.
ENABLE_DEMO_MODE=false
REQUIRE_EMAIL_VERIFICATION=false
# SQLite file; the old data/demo.json is imported once if DATABASE_FILE is omitted.
DATABASE_FILE=

# Transactional email: use a verified sender/domain in Resend.
RESEND_API_KEY=
EMAIL_FROM=
# Required in production with integrations. Generate with: npm run secrets:generate
INTEGRATION_ENCRYPTION_KEY=
# Google OAuth web application. Authorized redirect URI:
# http://localhost:3100/api/integrations/google/callback
# Add your HTTPS deployed origin separately for production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ENABLE_OUTBOX_WORKER=true

HINDSIGHT_BASE_URL=
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_PREFIX=continuum
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
REQUIRE_LIVE_INTEGRATIONS=false

# Comma-separated trusted origins for company-owned read-only database gateways.
# Example: https://support-api.your-company.com
PROVIDER_ALLOWED_ORIGINS=

# --- Unified company memory, follow-through and data sources (all optional) ---
# Hours the original customer has to confirm a specialist proposal. After the deadline,
# an unconfirmed proposal with C_init >= 0.75 and no policy blockers is published as
# "UNCONFIRMED BY CUSTOMER". Lower-confidence proposals are escalated instead.
CONFIRMATION_DEADLINE_HOURS=24
# Hours an unclaimed case may wait before it becomes an SLA escalation task.
CASE_SLA_HOURS=8
# Optional remote embedding model (OpenAI-compatible /embeddings). When empty or
# unreachable, retrieval uses the offline local concept embedding.
EMBEDDING_MODEL=
# Company data sources. Everything is off until the server owner allows it.
# REST sources: comma-separated https origins (hosts must resolve to public addresses).
DATA_SOURCE_ALLOWED_ORIGINS=
# SQLite sources: comma-separated directories that may be read (read-only handle).
DATA_SOURCE_SQLITE_DIRS=
# PostgreSQL sources need the optional "pg" package; set to "pg" once installed.
DATA_SOURCE_POSTGRES_DRIVER=
# Development only: allow http loopback origins for REST sources.
DATA_SOURCE_ALLOW_LOOPBACK=false
# The Interactive Learning Demo at /demo needs no configuration, credentials or network.

# --- Retention (all off unless set; days, 1–3650) ---
# Erase the content of conversations a customer archived more than N days ago.
RETENTION_ARCHIVED_CONVERSATION_DAYS=
# Delete finished (completed / auto-published / escalated) follow-through tasks older than N days.
RETENTION_FOLLOW_THROUGH_DAYS=
# Delete delivered/failed/skipped outbox jobs older than N days (pending work is never deleted).
RETENTION_OUTBOX_DAYS=

# --- Semantic search index (ChromaDB). Optional: without it, search runs on SQLite alone ("basic mode"). ---
# SQLite is always the source of truth; the index can be deleted and rebuilt (npm run index -- reindex).
# Start a local server with `docker compose up -d chroma` or `npm run chroma:start`.
# Chroma is never reached from the browser; keep it on a private network and put a token in front of it if shared.
VECTOR_STORE=
CHROMA_URL=
# CHROMA_TOKEN=
# Namespace for collection names (lets several apps share one Chroma server).
VECTOR_NAMESPACE=continuum
# Candidates taken from each branch before ranking (adaptive widening goes up to CANDIDATE_CAP when needed).
LEXICAL_TOP_K=20
VECTOR_TOP_K=20
CANDIDATE_CAP=400
# Pools up to this size are compared in full when no vector index is available.
SQLITE_SCAN_LIMIT=300
# Embeddings: "local" is the offline hashed-concept representation (NOT a neural model).
# For genuine semantic embeddings set an OpenAI-compatible model (it uses OPENAI_API_KEY / OPENAI_BASE_URL above).
# Changing the model rebuilds the index into its own collection; vectors of different models are never mixed.
EMBEDDING_PROVIDER=
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=
# Some OpenAI-compatible servers return embeddings without an "index" field. Accepting that means trusting the order of the
# array, so it is off by default; set to true only for a provider you have checked returns entries in input order.
# EMBEDDING_ALLOW_UNINDEXED=false

# --- Outbound connectors (REST / PostgreSQL). Everything stays off until you allow it. ---
# PostgreSQL needs the optional "pg" package (installed by default), the host allowlist below and TLS.
DATA_SOURCE_POSTGRES_DRIVER=
DATA_SOURCE_POSTGRES_HOSTS=
DATA_SOURCE_POSTGRES_PORTS=5432

# --- Case SLA milestones, in hours (CASE_SLA_HOURS above is the assignment deadline) ---
SLA_FIRST_RESPONSE_HOURS=4
SLA_INACTIVITY_HOURS=24
SLA_FOLLOW_UP_HOURS=24
SLA_RESOLUTION_HOURS=72

# --- Knowledge-source sync ---
# Rows fetched, mapped and written per step when a SQLite or PostgreSQL source is synced (10 to 5000).
DATA_SOURCE_BATCH_SIZE=500
# One sync run pauses here ("deferred") and the next run resumes; nothing is dropped. This is a safety limit, not a knowledge cap.
DATA_SOURCE_MAX_RECORDS=100000
# Local demos only: list fictional accounts on the sign-in page. Needs NODE_ENV=development or test; never set on a public host.
# DEMO_SIGNIN_HINTS=
# DEMO_SIGNIN_PASSWORD=
