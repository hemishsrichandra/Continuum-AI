# Use https://api.hindsight.vectorize.io for Cloud, or a self-hosted API URL.
HINDSIGHT_BASE_URL=
HINDSIGHT_API_KEY=
# Use a unique bank prefix per installation.
HINDSIGHT_BANK_PREFIX=continuum
# OpenAI or a Chat Completions-compatible provider.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
REQUIRE_LIVE_INTEGRATIONS=false
FRONTEND_PORT=3000
# Leave blank to choose an available port if 5000 is in use.
API_PORT=
