{
  "name": "continuum-ai",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node server/start.js",
    "test": "node --import ./test/setup-windows-cleanup.js --test",
    "demo": "node scripts/demo.js",
    "demo:multi": "node scripts/demo-multi-company.js",
    "test:http": "node scripts/check-http.js",
    "verify:live": "node scripts/verify-live.js",
    "evaluate": "node scripts/evaluate.js",
    "evaluate:live": "node scripts/evaluate.js --live",
    "secrets:generate": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('base64'))\"",
    "db:backup": "node scripts/db-backup.js",
    "demo:learning": "node scripts/demo-learning.js",
    "chroma:start": "chroma run --path ./data/chroma --host 127.0.0.1 --port 8000",
    "index": "node scripts/vector-admin.js",
    "benchmark": "node --import ./test/setup-windows-cleanup.js scripts/benchmark-rag.js --out evaluation/benchmark-results.json",
    "test:chroma": "node --import ./test/setup-windows-cleanup.js --test test/chroma-live.test.js",
    "verify:chroma": "node --import ./test/setup-windows-cleanup.js scripts/verify-chroma-live.js",
    "benchmark:semantic": "node --import ./test/setup-windows-cleanup.js scripts/benchmark-semantic.js --out evaluation/semantic-results.json",
    "benchmark:sync": "node scripts/benchmark-sync.js",
    "seed:sample": "node scripts/seed-sample-company.js",
    "serve:sample": "node scripts/serve-sample.js",
    "load-test": "node scripts/load-test.js --out evaluation/load-results.json",
    "rotate:key": "node scripts/rotate-integration-key.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "chromadb": "3.5.0",
    "three": "0.172.0"
  },
  "devDependencies": {
    "axe-core": "^4.10.3"
  },
  "optionalDependencies": {
    "pg": "8.20.0"
  }
}
